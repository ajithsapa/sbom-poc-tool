# SBOM POC Tool API — Environment variable template
# Copy this file to .env and adjust values for your environment.
# Session: SBOM-20260409-sb01
#
#   cp .env.template .env

# ------------------------------------------------------------------
# Server configuration
# ------------------------------------------------------------------
APP_NAME="SBOM POC Tool API"
HOST=0.0.0.0
PORT=8000
# Set RELOAD=True for development (auto-reload on code changes)
RELOAD=False
VERSION=0.1.0

# ------------------------------------------------------------------
# CORS allowed origins (JSON array string)
# ------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# NVD Cache database path
# ------------------------------------------------------------------
# ":memory:" — in-memory SQLite (data lost on restart; suitable for POC)
# "/data/nvd_cache.db" — persistent file-backed SQLite (recommended for staging+)
#
# NOTE: When using a file-backed path inside Docker, mount a volume:
#   docker run -v /host/data:/data -e NVD_CACHE_DB_PATH=/data/nvd_cache.db ...
NVD_CACHE_DB_PATH=:memory:

# ------------------------------------------------------------------
# API authentication (static shared key)
# ------------------------------------------------------------------
# When set, every endpoint except /api/v1/health requires the X-API-Key
# header to match this value. When unset/empty, auth is bypassed (POC
# dev mode) and a warning is logged at startup. Hand this value to test
# users; rotate by changing the value and restarting the server.
API_KEY=

# ------------------------------------------------------------------
# Git clone workspace (POST /api/v1/scans with repo_url)
# ------------------------------------------------------------------
# Directory under which public-repo clones are stored. Defaults to
# <session_root>/clones when blank.
SBOM_CLONES_DIR=
# Hard timeout (seconds) for `git clone --depth=1`.
SBOM_CLONE_TIMEOUT_SECONDS=120
# Max on-disk size (bytes) of a successful clone. Clones over this cap
# are deleted and the request fails with REPO_TOO_LARGE. Default 50 MB
# is ample for dependency manifests, blocks accidental dataset repos.
SBOM_MAX_CLONE_BYTES=50000000
